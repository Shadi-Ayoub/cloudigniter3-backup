{
  "schemaVersion": 1,
  "label": "JODARIS Website",
  "kind": "website",
  "project": "jodaris-website",
  "buildDirectories": ["dist"],
  "assets": false,
  "staticHosting": true,
  "commands": {
    "build-static": {
      "label": "Build static release",
      "command": "bash",
      "args": ["scripts/prepare-static-deploy.sh"]
    },
    "check-static": {
      "label": "Check static site",
      "command": "node",
      "args": ["scripts/check.mjs"]
    }
  }
}
