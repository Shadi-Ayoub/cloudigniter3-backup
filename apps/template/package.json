{
  "name": "@cloudigniter/template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p amplify/tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck",
    "lint": "next lint",
    "clean": "rimraf .next",
    "sso": "aws sso login --profile developer1",
    "sandbox": "npx ampx sandbox --profile developer1",
    "bootstrap:root": "node --import=tsx amplify/scripts/bootstrap-root-user.ts --profile developer1",
    "sandbox:bootstrap": "npx ampx sandbox --once --profile developer1 && pnpm run bootstrap:root",
    "sandbox:debug": "mkdir -p amplify/.logs && NODE_OPTIONS=\"--enable-source-maps --trace-uncaught\" ampx sandbox --profile developer1 --debug --once 2>&1 | tee amplify/.logs/amplify-sandbox-debug.log"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.7.2",
    "@aws-amplify/ui-react": "^6.15.3",
    "@tailwindcss/postcss": "^4.3.0",
    "aws-amplify": "^6.16.3",
    "aws-lambda": "^1.0.7",
    "deepmerge-ts": "^7.1.5",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.8.0",
    "next": "^16.2.1",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-auth": "^1.9.4",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@aws-amplify/backend-function": "^1.18.1",
    "@aws-amplify/data-schema": "^1.26.0",
    "@aws-amplify/plugin-types": "^1.12.1",
    "@cloudigniter/aws": "workspace:*",
    "@cloudigniter/config-ts": "workspace:*",
    "@cloudigniter/core": "workspace:*",
    "@cloudigniter/next": "workspace:*",
    "@cloudigniter/ui": "workspace:*",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "aws-cdk-lib": "^2.261.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
