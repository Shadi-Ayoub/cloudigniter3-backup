{
  "extends": "@cloudigniter/config-ts/next.json",
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ci-next/*": [
        "../../packages/next/src/*"
      ],
      "@ci-core/*": [
        "../../packages/core/src/*"
      ],
      "@ci-aws/*": [
        "../../packages/aws/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "cloudigniter.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
