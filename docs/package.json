{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "pnpm guide:check && pnpm dates:check && docusaurus clear",
    "start": "docusaurus start -p 3010",
    "prebuild": "pnpm guide:check && pnpm dates:check && docusaurus clear",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "dates:update": "node scripts/page-dates.mjs --update",
    "dates:check": "node scripts/page-dates.mjs --check",
    "test:dates": "node --test scripts/page-dates.test.mjs",
    "guide:check": "node scripts/check-user-guide.mjs && node scripts/check-commands.mjs && node scripts/check-learning-content.mjs",
    "test:search": "node --import tsx --test scripts/guide-search.test.ts",
    "test:command-references": "node --import tsx --test scripts/command-references.test.ts",
    "test:dictionary": "node --import tsx --test scripts/dictionary.test.ts",
    "build:hosting": "pnpm guide:check && pnpm dates:check && node scripts/build-hosting.mjs",
    "build:prod": "pnpm build:hosting",
    "test:hosting": "node --test scripts/hosting.test.mjs && node --import tsx --test scripts/editions.test.ts"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.469.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
