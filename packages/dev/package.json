{
  "name": "@cloudigniter/dev",
  "version": "0.1.0",
  "description": "Private CloudIgniter developer toolkit for package builds, maintenance and reviewed release requests.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "dev": "./bin/dev.mjs"
  },
  "exports": {
    "./tooling/entries": "./src/tooling/ci-entries.mjs",
    "./tooling/inject-use-client": "./src/tooling/ci-inject-use-client.mjs",
    "./tooling/tsup": "./src/tooling/ci-tsup-config.ts",
    "./types": {
      "types": "./src/types/index.d.mts",
      "import": "./src/types/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "postinstall": "node ./bin/setup-github.mjs",
    "typecheck": "node ./bin/dev.mjs package typecheck",
    "test": "node ./bin/dev.mjs package test",
    "check": "node ./bin/dev.mjs package check",
    "check:package": "node ./bin/dev.mjs package check-package",
    "prepublishOnly": "node ./bin/dev.mjs package prepublish",
    "test:watch": "node ./bin/dev.mjs package test --watch"
  },
  "dependencies": {
    "@changesets/assemble-release-plan": "6.0.9",
    "@changesets/config": "3.1.3",
    "@changesets/pre": "2.0.2",
    "@changesets/read": "0.6.7",
    "@manypkg/get-packages": "1.1.3",
    "execa": "^9.6.1",
    "meow": "^14.1.0",
    "semver": "^7.8.5",
    "fast-glob": "^3.3.3",
    "javascript-obfuscator": "^5.4.1",
    "jsonc-parser": "^3.3.1",
    "enquirer": "^2.4.1",
    "ora": "^9.4.1",
    "tsx": "^4.23.1",
    "@cloudigniter/cli": "workspace:*"
  },
  "devDependencies": {
    "@changesets/types": "6.1.0",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.2",
    "esbuild": "^0.28.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0",
    "tsup": "^8.5.1"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "tsup": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudigniter-io/build-cloudigniter-dev.git"
  }
}
