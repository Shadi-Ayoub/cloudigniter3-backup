{
  "name": "workspace-terminals",
  "displayName": "CloudIgniter Workspace Terminals",
  "description": "Manages local integrated terminals for the private CloudIgniter Developer Toolkit.",
  "publisher": "cloudigniter",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cloudigniter.workspaceTerminals.closeAll",
        "title": "Close All Local Terminals",
        "category": "CloudIgniter"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
