{
  "name": "@cloudigniter/aws",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./server/backend": {
      "types": "./src/server/backend/index.ts",
      "import": "./src/server/backend/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "switch:src": "dev package switch --target=src",
    "switch:dist": "dev package switch --target=dist",
    "clean": "dev package clean",
    "clean:maps": "dev package clean-maps",
    "clean:dts": "dev package clean-dts",
    "build": "dev package build --mode=dev",
    "build:dev": "dev package build --mode=dev",
    "build:prod": "dev package build --mode=prod",
    "build:js": "dev package build-js",
    "build:types:clean": "dev package clean-types",
    "build:types": "dev package build-types",
    "build:types:raw": "dev package build-types-raw",
    "build:assets": "dev package build-assets",
    "obfuscate": "dev package obfuscate",
    "typecheck": "dev package typecheck",
    "test": "dev package test",
    "check:package": "dev package check-package",
    "dev": "dev package watch",
    "typecheck:tools": "dev package typecheck --scope=tools",
    "check": "dev package check",
    "scan:client-directives": "dev quality scan-client-directives",
    "list:client-files": "dev quality list-client-files",
    "test:watch": "dev package test --watch"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.3",
    "@aws-sdk/client-cloudformation": "^3.1022.0",
    "@aws-sdk/client-cloudwatch": "^3.1024.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1024.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1023.0",
    "@aws-sdk/client-dynamodb": "^3.1022.0",
    "@aws-sdk/client-lambda": "^3.1079.0",
    "@aws-sdk/lib-dynamodb": "^3.1022.0",
    "@cloudigniter/core": "workspace:*",
    "@cloudigniter/emberguard": "workspace:*",
    "aws-lambda": "^1.0.7",
    "deepmerge-ts": "^7.1.5"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudigniter/dev": "workspace:*",
    "@cloudigniter/config-ts": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@smithy/types": "^4.13.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "aws-amplify": "^6.16.3",
    "esbuild": "^0.28.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudigniter-io/build-cloudigniter-aws.git"
  }
}
