{
  "name": "@cloudigniter/ui",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "switch:src": "ci-dev package switch --target=src",
    "switch:dist": "ci-dev package switch --target=dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "ci-dev package clean-maps",
    "clean:dts": "ci-dev package clean-dts",
    "build": "pnpm run build:dev",
    "build:dev": "ci-dev package build --mode=dev",
    "build:prod": "ci-dev package build --mode=prod",
    "build:js": "tsup --config tsup.config.ts",
    "build:types:clean": "rm -rf dist/.types",
    "build:types": "NODE_OPTIONS=--max-old-space-size=12288 rollup -c rollup.config.js",
    "build:types:raw": "tsc -p tsconfig.build.json",
    "build:assets": "pnpm -v",
    "obfuscate": "ci-dev package obfuscate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "test": "node --import=tsx --test __tests__/*.test.ts __tests__/security/*.test.ts",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools",
    "scan:client-directives": "ci-dev quality scan-client-directives",
    "list:client-files": "ci-dev quality list-client-files"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^9.1.0",
    "antd": "^6.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.1",
    "formik": "^2.4.9",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudigniter/cli": "workspace:*",
    "@cloudigniter/config-ts": "workspace:*",
    "@cloudigniter/core": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@smithy/types": "^4.13.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
