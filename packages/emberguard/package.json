{
  "name": "@cloudigniter/emberguard",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./providers/aws": {
      "types": "./src/providers/aws/index.ts",
      "import": "./src/providers/aws/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "switch:src": "node ../../scripts/ci-switch-sources.mjs src",
    "switch:dist": "node ../../scripts/ci-switch-sources.mjs dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "node ../../scripts/ci-clean-dist-maps.mjs",
    "clean:dts": "node ../../scripts/ci-clean-dts-map.cjs",
    "build": "pnpm run build:dev",
    "build:dev": "node ../../scripts/ci-build-package.mjs dev",
    "build:prod": "node ../../scripts/ci-build-package.mjs prod",
    "build:js": "tsup --config tsup.config.ts",
    "build:types:clean": "rm -rf dist/.types",
    "build:types": "NODE_OPTIONS=--max-old-space-size=12288 rollup -c rollup.config.js",
    "build:types:raw": "tsc -p tsconfig.build.json",
    "build:assets": "pnpm -v",
    "obfuscate": "node ../../scripts/ci-obfuscate-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "test": "node --import=tsx --test __tests__/auth/*.test.ts",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools",
    "scan:client-directives": "node ../../scripts/ci-scan-missing-use-client.mjs",
    "list:client-files": "node ../../scripts/ci-list-client-files.mjs"
  },
  "devDependencies": {
    "@cloudigniter/config-ts": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/node": "^25.5.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
