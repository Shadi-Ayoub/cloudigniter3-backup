{
  "name": "@cloudigniter/core",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "switch:src": "ci-dev package switch --target=src",
    "switch:dist": "ci-dev package switch --target=dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "ci-dev package clean-maps",
    "clean:dts": "ci-dev package clean-dts",
    "build": "pnpm run build:dev",
    "build:dev": "ci-dev package build --mode=dev",
    "build:prod": "ci-dev package build --mode=prod",
    "build:js": "tsup --config tsup.config.ts",
    "build:types:clean": "rm -rf dist/.types",
    "build:types": "NODE_OPTIONS=--max-old-space-size=12288 rollup -c rollup.config.js",
    "build:types:raw": "tsc -p tsconfig.build.json",
    "build:assets": "pnpm -v",
    "obfuscate": "ci-dev package obfuscate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "test": "node --import=tsx --test __tests__/auth/access-control.test.ts __tests__/icon/ci-resolve-icon.test.ts __tests__/route/ci-merge-route-maps.test.ts __tests__/route/tenant-route-scope.test.ts __tests__/table/ci-table-key.test.ts",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools",
    "scan:client-directives": "ci-dev quality scan-client-directives",
    "list:client-files": "ci-dev quality list-client-files"
  },
  "devDependencies": {
    "@cloudigniter/cli": "workspace:*",
    "@cloudigniter/config-ts": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@cloudigniter/emberguard": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.5",
    "deepmerge-ts": "^7.1.5",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.8.0",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  }
}
