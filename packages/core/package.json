{
  "name": "@cloudigniter/core",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./types": {
      "import": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "switch:src": "node ../../scripts/ci-switch-sources.mjs src",
    "switch:dist": "node ../../scripts/ci-switch-sources.mjs dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "rimraf dist/*.map dist/**/*.map",
    "clean:dts": "node ../../scripts/ci-clean-dts-map.cjs",
    "build": "pnpm run build:dev",
    "build:dev": "NODE_ENV=development pnpm run clean && pnpm run switch:src && pnpm run build:js && pnpm run build:types:raw && pnpm run build:types && pnpm run build:types:clean && pnpm run build:assets",
    "build:prod": "NODE_ENV=production pnpm run clean && pnpm run switch:src && pnpm run build:js && pnpm run build:types:raw && pnpm run build:types && pnpm run build:types:clean && pnpm run build:assets && pnpm run clean:maps &&  pnpm run obfuscate && pnpm run switch:dist",
    "build:js": "tsup --config tsup.config.ts",
    "build:types:clean": "rm -rf dist/.types",
    "build:types": "NODE_OPTIONS=--max-old-space-size=12288 rollup -c rollup.config.js",
    "build:types:raw": "tsc -p tsconfig.build.json",
    "build:assets": "pnpm -v",
    "obfuscate": "node ../../scripts/ci-obfuscate-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools"
  },
  "devDependencies": {
    "@cloudigniter/config-ts": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.5",
    "deepmerge-ts": "^7.1.5",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.8.0",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  }
}
