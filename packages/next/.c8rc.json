{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/types/**",
    "**/index.ts",
    "**/delete/**",
    "**/delete-*",
    "**/example-usage.ts"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text-summary",
    "json-summary",
    "lcov",
    "html"
  ],
  "reports-dir": "coverage"
}
