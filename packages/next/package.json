{
  "name": "@cloudigniter/next",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./settings/server": {
      "types": "./dist/settings/server/index.d.ts",
      "import": "./dist/settings/server/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .tsbuildinfo",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:assets": "pnpm -v",
    "obfuscate": "node ../../scripts/ci-obfuscate-package.mjs",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run build:assets && pnpm run obfuscate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.7.2",
    "@aws-amplify/ui-react": "^6.15.3",
    "@cloudigniter/aws": "workspace:*",
    "@cloudigniter/core": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.5",
    "aws-amplify": "^6.16.3",
    "class-variance-authority": "^0.7.1",
    "formik": "^2.4.9",
    "lucide-react": "^1.8.0",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudigniter/config-ts": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2"
  }
}
