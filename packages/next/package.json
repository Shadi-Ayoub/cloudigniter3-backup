{
  "name": "@cloudigniter/next",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./locales": {
      "types": "./src/locales/index.ts",
      "import": "./src/locales/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./server/proxy": {
      "types": "./src/server/proxy/index.ts",
      "import": "./src/server/proxy/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./ui/client": {
      "types": "./src/ui/client/index.ts",
      "import": "./src/ui/client/index.ts"
    },
    "./ui/server": {
      "types": "./src/ui/server/index.ts",
      "import": "./src/ui/server/index.ts"
    },
    "./layout/app-standard": {
      "types": "./src/layout/app-standard/index.ts",
      "import": "./src/layout/app-standard/index.ts"
    },
    "./layout/cp-standard": {
      "types": "./src/layout/cp-standard/index.ts",
      "import": "./src/layout/cp-standard/index.ts"
    },
    "./layout/login-standard": {
      "types": "./src/layout/login-standard/index.ts",
      "import": "./src/layout/login-standard/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    },
    "./styles/standard/style.css": "./src/styles/standard/style.css",
    "./styles/standard/theme.css": "./src/styles/standard/theme.css"
  },
  "scripts": {
    "switch:src": "node ../../scripts/ci-switch-sources.mjs src",
    "switch:dist": "node ../../scripts/ci-switch-sources.mjs dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "node ../../scripts/ci-clean-dist-maps.mjs",
    "clean:dts": "node ../../scripts/ci-clean-dts-map.cjs",
    "test:style": "node ./scripts/ci-test-style.mjs",
    "build": "pnpm --silent run build:dev",
    "build:dev": "node ../../scripts/ci-build-package.mjs dev",
    "build:prod": "node ../../scripts/ci-build-package.mjs prod",
    "build:dev2": "NODE_ENV=development pnpm run clean && pnpm run switch:src && pnpm run build:js && pnpm run build:types:raw && pnpm run build:types && pnpm run build:assets",
    "build:prod2": "NODE_ENV=production pnpm run clean && pnpm run switch:src && pnpm run build:js && pnpm run build:types:raw && pnpm run build:types && pnpm run build:types:clean && pnpm run build:assets && pnpm run clean:maps &&  pnpm run obfuscate && pnpm run switch:dist",
    "build:js": "tsup --config tsup.config.ts",
    "build:types:clean": "rimraf dist/.types",
    "build:types": "NODE_OPTIONS=--max-old-space-size=12288 rollup -c rollup.config.js",
    "build:types:raw": "tsc -p tsconfig.build.json",
    "build:assets": "node ./scripts/build-assets.mjs && pnpm -v",
    "obfuscate": "node ../../scripts/ci-obfuscate-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools",
    "scan:client-directives": "node ../../scripts/ci-scan-missing-use-client.mjs",
    "list:client-files": "node ../../scripts/ci-list-client-files.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@aws-amplify/adapter-nextjs": "^1.7.2",
    "@aws-amplify/auth": "^6.20.0",
    "@aws-amplify/ui-react": "^6.15.3",
    "@cloudigniter/aws": "workspace:*",
    "@cloudigniter/core": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.5",
    "aws-amplify": "^6.16.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge-ts": "^7.1.5",
    "formik": "^2.4.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.38.0",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zod-formik-adapter": "^2.0.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudigniter/config-ts": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2"
  }
}
