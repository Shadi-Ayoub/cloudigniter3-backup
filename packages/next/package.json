{
  "name": "@cloudigniter/next",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./locales": {
      "types": "./src/locales/index.ts",
      "import": "./src/locales/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./server/proxy": {
      "types": "./src/server/proxy/index.ts",
      "import": "./src/server/proxy/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./ui/server": {
      "types": "./src/ui/server/index.ts",
      "import": "./src/ui/server/index.ts"
    },
    "./ui/client": {
      "types": "./src/ui/client/index.ts",
      "import": "./src/ui/client/index.ts"
    },
    "./layout/app-standard": {
      "types": "./src/layout/app-standard/index.ts",
      "import": "./src/layout/app-standard/index.ts"
    },
    "./layout/cp-standard": {
      "types": "./src/layout/cp-standard/index.ts",
      "import": "./src/layout/cp-standard/index.ts"
    },
    "./layout/login-standard": {
      "types": "./src/layout/login-standard/index.ts",
      "import": "./src/layout/login-standard/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    },
    "./styles/standard/style.css": "./src/styles/standard/style.css",
    "./styles/standard/theme.css": "./src/styles/standard/theme.css"
  },
  "scripts": {
    "switch:src": "node ../../scripts/ci-switch-sources.mjs src",
    "switch:dist": "node ../../scripts/ci-switch-sources.mjs dist",
    "clean": "rimraf dist .tsbuildinfo",
    "clean:maps": "rimraf dist/*.map dist/**/*.map",
    "build": "pnpm run build:dev",
    "build:dev": "NODE_ENV=development pnpm run switch:src && pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run build:assets",
    "build:prod": "NODE_ENV=production pnpm run switch:dist && pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run build:assets && pnpm run obfuscate && pnpm run clean:maps",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:assets": "node ./scripts/build-assets.mjs && pnpm -v",
    "obfuscate": "node ../../scripts/ci-obfuscate-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "npm pack --dry-run",
    "dev": "tsup --watch",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:tools"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@aws-amplify/adapter-nextjs": "^1.7.2",
    "@aws-amplify/ui-react": "^6.15.3",
    "@cloudigniter/aws": "workspace:*",
    "@cloudigniter/core": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.5",
    "aws-amplify": "^6.16.3",
    "deepmerge-ts": "^7.1.5",
    "formik": "^2.4.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.8.0",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zod-formik-adapter": "^2.0.0"
  },
  "peerDependencies": {
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudigniter/config-ts": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2"
  }
}
