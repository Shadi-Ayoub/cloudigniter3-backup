{
  "name": "@cloudigniter/cli",
  "version": "0.0.1",
  "description": "Command-line tooling for CloudIgniter applications and operators.",
  "type": "module",
  "bin": {
    "ci": "./bin/ci.mjs"
  },
  "exports": {
    "./runtime/resource-file-transaction": {
      "types": "./src/runtime/ci-resource-file-transaction.d.mts",
      "import": "./src/runtime/ci-resource-file-transaction.mjs"
    },
    "./types": {
      "types": "./src/types/index.d.mts",
      "import": "./src/types/index.mjs"
    },
    "./tooling/modules": {
      "types": "./src/tooling/ci-validate-modules.d.mts",
      "import": "./src/tooling/ci-validate-modules.mjs"
    },
    "./runtime/package-entry": {
      "types": "./src/runtime/ci-import-package-entry.d.mts",
      "import": "./src/runtime/ci-import-package-entry.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "dev package typecheck",
    "test": "dev package test",
    "check": "dev package check",
    "check:package": "dev package check-package",
    "test:watch": "dev package test --watch"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "execa": "^9.6.1",
    "meow": "^14.1.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudigniter-io/build-cloudigniter-cli.git"
  }
}
