  "scripts": {
    "dev": "pnpm modules:generate && pnpm forms:generate && next dev",
    "build": "pnpm modules:generate && pnpm forms:generate && next build",
    "start": "next start",
    "modules:generate": "node --import=tsx scripts/generate-modules.mts",
    "forms:generate": "node --import=tsx src/custom/forms/generate-smart-forms.mts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck",
    "clean": "rimraf .next",
    "resources:studio": "ci resources studio",
    "sandbox": "pnpm modules:generate && ampx sandbox --once",
    "sso": "aws sso login",
    "bootstrap:root": "ci amplify bootstrap root-user --no-interactive",
    "bootstrap:access-control": "ci amplify bootstrap access-control --no-interactive",
    "sandbox:bootstrap": "ci amplify sandbox bootstrap --no-interactive"
  },
  "replacements": {
    "next.config.ts": [
      {
        "from": "path.resolve(__dirname, \"../../..\")",
        "to": "path.resolve(__dirname)"
      }
    ],
    "src/app/globals.css": [
      {
        "from": "@source \"../../../../../packages/aws/src/**/*.{ts,tsx}\";",
        "to": "@source \"../../node_modules/@cloudigniter/aws/dist/**/*.{js,mjs,cjs}\";"
      },
      {
        "from": "@source \"../../../../../packages/core/src/**/*.{ts,tsx}\";",
        "to": "@source \"../../node_modules/@cloudigniter/core/dist/**/*.{js,mjs,cjs}\";"
      },
      {
        "from": "@source \"../../../../../packages/next/src/**/*.{ts,tsx}\";",
        "to": "@source \"../../node_modules/@cloudigniter/next/dist/**/*.{js,mjs,cjs}\";"
      },
      {
        "from": "@source \"../../../../../packages/ui/src/**/*.{ts,tsx}\";",
        "to": "@source \"../../node_modules/@cloudigniter/ui/dist/**/*.{js,mjs,cjs}\";"
      }
    ],
    "src/kernel/client/data/app-data-client.ts": [
      {
        "from": "\"@ci-aws/types\"",
        "to": "\"@cloudigniter/aws/types\""
      }
    ]
  },
  "dependencyVersions": {
    "next": "16.2.2",
    "server-only": "0.0.1"
  }
